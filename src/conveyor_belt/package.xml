<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>conveyor_belt</name>
  <version>2.0.0</version>
  <description>Conveyor Belt for Gazebo Harmonic (gz-sim8) with ROS2.</description>
  <maintainer email="sparab@umd.edu">shantanu</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>gz_plugin_vendor</build_depend>
  <build_depend>gz_sim_vendor</build_depend>
  <build_depend>xacro</build_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>gz_plugin_vendor</exec_depend>
  <exec_depend>gz_sim_vendor</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
