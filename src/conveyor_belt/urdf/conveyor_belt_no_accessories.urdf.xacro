<?xml version="1.0"?>
<robot name="conveyor_belt_no_accessories" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="world"/>

  <link name="base_link">
    <inertial>
      <origin xyz="1.15972439062802E-17 -0.0273162100367329 1.02144955943776E-17" rpy="0 0 0"/>
      <mass value="2430.68583470577"/>
      <inertia
        ixx="431.198140853202"
        ixy="2.18658245479853E-14"
        ixz="4.38017677684144E-14"
        iyy="7514.31711977665"
        iyz="3.72364768160213E-15"
        izz="7545.20095484556"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://conveyor_belt/meshes/base_link.STL"/>
      </geometry>
      <material name="graphite_frame">
        <color rgba="0.34 0.35 0.37 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://conveyor_belt/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="belt_link">
    <inertial>
      <origin xyz="2.84 0.005 2.76334119905601E-17" rpy="0 0 0"/>
      <mass value="56.8"/>
      <inertia
        ixx="4.73380666666667"
        ixy="3.71142749699624E-34"
        ixz="2.20830761084774E-15"
        iyy="157.442026666667"
        iyz="2.30486925841449E-19"
        izz="152.709166666667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://conveyor_belt/meshes/belt_link.STL"/>
      </geometry>
      <material name="belt_black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://conveyor_belt/meshes/belt_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="belt_joint" type="prismatic">
    <origin xyz="-2.83 0 0.3" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="belt_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.01" effort="1000" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>belt_joint</joint_name>
      <initial_velocity>0.0</initial_velocity>
    </plugin>
    <plugin filename="libconveyor_belt_plugin.so"
            name="conveyor_belt::ConveyorBeltPlugin">
      <joint_name>belt_joint</joint_name>
      <lower_limit>0.0</lower_limit>
      <upper_limit>0.01</upper_limit>
      <reset_epsilon>0.0005</reset_epsilon>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.20 0.21 0.22 1</ambient>
        <diffuse>0.34 0.35 0.37 1</diffuse>
        <specular>0.22 0.22 0.22 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="belt_link">
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0 0 0 1</diffuse>
        <specular>0.06 0.06 0.06 1</specular>
      </material>
    </visual>
  </gazebo>

</robot>
