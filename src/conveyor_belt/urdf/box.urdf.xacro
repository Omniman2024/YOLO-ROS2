<?xml version="1.0"?>
<robot name="box" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="mesh_uri" default="package://conveyor_belt/meshes/box/box.dae"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.0617" ixy="0" ixz="0"
        iyy="0.0617" iyz="0"
        izz="0.12"/>
    </inertial>

    <!-- Visual: DAE with texture on top -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="$(arg mesh_uri)"/>
      </geometry>
    </visual>

    <!-- Collision: simple box primitive matching exact DAE size -->
    <!-- 0.6 x 0.6 x 0.1 m, origin at centre of mass -->
    <collision>
      <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.1"/>
      </geometry>
    </collision>
  </link>

</robot>
